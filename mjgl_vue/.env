# 前端构建/运行时（Vite）：复制为 .env 或 .env.local 后按需修改

# 生产环境 API 根路径，例如 https://api.example.com（开发时通常留空，走 Vite 代理 /api）
VITE_API_BASE_URL=

# 开发时 Vite 代理后端地址（仅 vite.config 使用）
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

# Axios 超时（毫秒）
VITE_REQUEST_TIMEOUT_MS=10000

# WebSocket（SockJS 路径为站点根相对路径）
VITE_WS_PATH=/ws
VITE_WS_RECONNECT_DELAY_MS=5000

# 业务魔法数：全量模具分页上限、审批看板单次查询条数
VITE_LIST_PAGE_SIZE_MAX=1000
VITE_APPROVAL_DASHBOARD_PAGE_SIZE=200
