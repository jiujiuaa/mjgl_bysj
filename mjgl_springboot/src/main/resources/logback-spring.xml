<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">

    <!-- 引入 Spring Boot 默认的日志配置（包含原来的彩色控制台样式） -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 每周滚动的文件输出（周一为一周开始，使用周序号） -->
    <appender name="WEEKLY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/mjgl.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 以 年-周 的方式切分日志文件，例如 mjgl.2026-10.log 表示 2026 年第 10 周 -->
            <fileNamePattern>logs/mjgl.%d{yyyy-ww}.log</fileNamePattern>
            <!-- 最多保留 12 周日志，可根据需要调整 -->
            <maxHistory>12</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- 统一根日志级别：沿用 Spring Boot 的 CONSOLE 配置 + 自定义每周滚动文件 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="WEEKLY_FILE"/>
    </root>

    <!-- 可根据需要单独降低/提高某些包的日志级别 -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="com.zjb.mjgl" level="INFO"/>

</configuration>

